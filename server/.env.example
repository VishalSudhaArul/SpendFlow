# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (configured in Phase 3)
MONGODB_URI=

# Long random string used to sign JWTs (configured in Phase 4)
JWT_SECRET=

# Google Gemini API key from https://aistudio.google.com/app/apikey (configured in Phase 8)
GEMINI_API_KEY=

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
