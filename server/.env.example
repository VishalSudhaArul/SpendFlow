# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (configured in Phase 3)
MONGODB_URI=
# Database name inside the cluster (created automatically on first write)
MONGODB_DB_NAME=spendflow-ai

# Long random string (32+ chars) used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
# lax (default) when the frontend and API share a site; none only for cross-site hosting
COOKIE_SAME_SITE=lax

# Google Gemini API key from https://aistudio.google.com/app/apikey (configured in Phase 8)
GEMINI_API_KEY=

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
